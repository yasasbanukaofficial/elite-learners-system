<AnchorPane fx:id="ancAddPayment" prefHeight="400.0" prefWidth="400.0" style="-fx-border-color: black; -fx-border-radius: 10px; -fx-background-radius: 10px;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.learners.controller.AddPaymentFormController">
   <children>
